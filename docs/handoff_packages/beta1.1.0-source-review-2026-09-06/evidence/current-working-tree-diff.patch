+def _legacy_court_code(task_id: str, title: str) -> str:
+    """Deterministic court code for a create that has no standard-session identity.
+
+    Keeps legacy (non case-selection) creates fully bound to a court code so the
+    semantic invariant capsule, case reference and archive receipts all agree on
+    one code, even though no session allocation was issued.  This is a stable,
+    valid ``COURT-<date>-<seq>-<suffix>`` code matching the court_code contract.
+    """
+
+    date_text = datetime.now(timezone.utc).strftime("%Y%m%d")
+    digest = hashlib.sha256(f"{task_id}:{title}".encode("utf-8")).hexdigest().upper()
+    sequence = str(int(digest[:6], 16))
+    suffix = digest[-4:]
+    return f"COURT-{date_text}-{sequence}-{suffix}"
+
